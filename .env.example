# Supabase → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URI for Vercel (port 6543) or Session mode for local.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Storage bucket name (create as Private in Supabase Storage)
SUPABASE_STORAGE_BUCKET=torix-files

# Internal login (owner)
TORIX_OWNER_EMAIL=owner@company.com
TORIX_OWNER_ID=torix-owner
TORIX_OWNER_PASSWORD=change-me
# Optional: staff share this password once their email is added in Users and roles
TORIX_STAFF_PASSWORD=change-me-staff

# Cookie signing secret
AUTH_SECRET=long-random-string
